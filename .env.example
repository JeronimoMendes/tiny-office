# Optional. Local defaults work without an .env file.
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=office
# Leave blank to print a randomly generated first-owner secret at startup.
BOOTSTRAP_SECRET=
# Self-service sign-in links. Both are required to enable email delivery;
# without them members depend on the owner for links. Percent-encode credentials
# (a login that is an email address contains an @). Match the scheme to the port:
# smtps:// on 465 is implicit TLS, smtp:// on 587 upgrades via STARTTLS and takes
# ?requireTLS=true to insist on it.
SMTP_URL=
MAIL_FROM=
# Browser-facing LiveKit WebSocket URL. Use wss:// on HTTPS deployments.
LIVEKIT_WS_URL=ws://localhost:7880
# Compose development credentials; replace both for deployment.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_BIND_ADDRESS=127.0.0.1
# Address LiveKit advertises to browsers; the public IP when deployed.
LIVEKIT_NODE_IP=127.0.0.1
